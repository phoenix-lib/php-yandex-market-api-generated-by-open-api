{
    "name": "phoenix-lib/php-yandex-market-api-generated-by-open-api",
    "description": "Generated PHP client for Yandex Market Partner API.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/phoenix-lib/php-yandex-market-api-generated-by-open-api",
    "license": "Unlicense",
    "authors": [
        {
            "name": "phoenix-lib",
            "homepage": "https://github.com/phoenix-lib"
        }
    ],
    "require": {
        "php": "^7.4|^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "OpenAPI\\Client\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenAPI\\Client\\Test\\": "test/"
        }
    }
}
